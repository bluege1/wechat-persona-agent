# ══════════════════════════════════════════════════════
#  环境
# ══════════════════════════════════════════════════════
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ══════════════════════════════════════════════════════
#  备份与临时（我自己的开发残留，不该进仓库）
# ══════════════════════════════════════════════════════
*.bak
*.bak-*
_历史备份/
_备份_*/
_scan/
_tmp_*
_page_syntax_check.js

# ══════════════════════════════════════════════════════
#  运行期产物 —— 这里面是真实聊天痕迹，一律不进
#  （不加前导斜杠 = 任意层级都拦；下同）
# ══════════════════════════════════════════════════════
日志/
生活/
记忆/
audio/
音色/
表情包/
*.log
*.wav
*.mp3

# 只要根目录那个「共享世界书」目录不进仓库；
# 角色包里的 角色/*/世界/ 是**要**进仓库的（那是示例角色的世界观），
# 所以这里必须加前导斜杠锚定到仓库根，否则会被一起误伤。
/世界/

# ══════════════════════════════════════════════════════
#  密钥与本地配置
#  注意：示例角色的 config.yaml **是要进仓库的**（值全是占位符），
#       所以这里不能写成笼统的 config.yaml —— 那样会把示例配置也挡掉，
#       别人 clone 下来直接跑不起来。只拦本机专用那份。
# ══════════════════════════════════════════════════════
.env
config.local.yaml
*.pem
*.key
*.token

# ══════════════════════════════════════════════════════
#  第三方二进制 / 驱动（无分发授权，绝不入库）
# ══════════════════════════════════════════════════════
驱动/
VBCable/
